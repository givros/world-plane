{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planes3d.local/worldclaw/asset_registry.schema.json",
  "title": "Planes3D Asset Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "sourceRevision", "classificationValues", "registryPolicies", "materialSets", "assets", "pilot"],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/semver" },
    "status": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "classificationValues": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "registryPolicies": { "type": "object" },
    "materialSets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "kind"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "source": { "$ref": "#/$defs/sourcePath" },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "classification", "status", "sourceKind", "source"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "classification": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "sourceKind": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/sourcePath" },
          "capacityPerChunkSlot": { "type": "integer", "minimum": 1 },
          "sharedActiveCapacity": { "type": "integer", "minimum": 1 },
          "instanceCount": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "pilot": {
      "type": "object",
      "required": ["id", "existingAssetIds", "requiredHeroAssetIds", "approvedMissingAssetIds"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "existingAssetIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "requiredHeroAssetIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "approvedMissingAssetIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourcePath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/#-]+$" }
  }
}
