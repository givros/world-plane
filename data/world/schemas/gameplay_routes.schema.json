{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planes3d.local/worldclaw/gameplay_routes.schema.json",
  "title": "Planes3D Gameplay Routes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "sourceRevision", "coordinateSystem", "actors", "spawns", "operationalZones", "airfieldMetadata", "routes", "visualOnlyPaths", "controls", "collision", "persistence", "multiplayer", "farming", "preservedRuntimeApi"],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/semver" },
    "status": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "coordinateSystem": { "type": "object" },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "assetId", "control", "spawnIds"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "assetId": { "$ref": "#/$defs/stableId" },
          "spawnIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } }
        }
      }
    },
    "spawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "regionId", "zoneId", "positionMeters", "yawRadians"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "regionId": { "$ref": "#/$defs/stableId" },
          "zoneId": { "$ref": "#/$defs/stableId" },
          "positionMeters": { "$ref": "#/$defs/vec3" },
          "yawRadians": { "type": "number" }
        }
      }
    },
    "operationalZones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    },
    "airfieldMetadata": { "type": "object" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sourceStatus", "critical", "kind", "regionIds", "actorIds"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "critical": { "type": "boolean" },
          "regionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
          "actorIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
          "startSpawnId": { "$ref": "#/$defs/stableId" },
          "toSpawnId": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "visualOnlyPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "regionIds", "kind"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "regionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } }
        }
      }
    },
    "controls": { "type": "object" },
    "collision": { "type": "object" },
    "persistence": { "type": "object" },
    "multiplayer": { "type": "object" },
    "farming": { "type": "object" },
    "preservedRuntimeApi": { "type": "object" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
  }
}
