{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planes3d.local/worldclaw/region_graph.schema.json",
  "title": "Planes3D Region Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "sourceRevision", "nodeIdentity", "semanticPriorityHighToLow", "regions", "zones", "landmarks", "edges", "proceduralAdjacency", "initialChunkWindowDerivedFromCurrentSeed", "pilot"],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/semver" },
    "status": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "nodeIdentity": { "type": "object" },
    "semanticPriorityHighToLow": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "semanticColor"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "kind": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "semanticColor": { "$ref": "#/$defs/color" },
          "underlyingRegionId": { "$ref": "#/$defs/stableId" },
          "routeIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
          "spawnIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
          "materialSetIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
          "repeatedAssetIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
          "landmarkPatternId": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "parentRegionId", "kind", "semanticColor"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "parentRegionId": { "$ref": "#/$defs/stableId" },
          "kind": { "type": "string", "minLength": 1 },
          "semanticColor": { "$ref": "#/$defs/color" }
        }
      }
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "regionId", "assetId", "worldUniqueness"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "regionId": { "$ref": "#/$defs/stableId" },
          "assetId": { "$ref": "#/$defs/stableId" },
          "position": { "$ref": "#/$defs/vec3" },
          "localPositionXZ": { "$ref": "#/$defs/vec2" },
          "yawRadians": { "type": "number" },
          "uniformScale": { "type": "number", "exclusiveMinimum": 0 },
          "worldUniqueness": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relationship"],
        "properties": {
          "from": { "$ref": "#/$defs/stableId" },
          "to": { "$ref": "#/$defs/stableId" },
          "relationship": { "type": "string", "minLength": 1 }
        }
      }
    },
    "proceduralAdjacency": { "type": "object" },
    "initialChunkWindowDerivedFromCurrentSeed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunkId", "regionId"],
        "properties": {
          "chunkId": { "$ref": "#/$defs/chunkId" },
          "regionId": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "pilot": {
      "type": "object",
      "required": ["id", "kind", "chunkId", "chunkCoordinates", "center", "boundsXZ", "regionId", "createsNewRuntimeRegion"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "chunkId": { "$ref": "#/$defs/chunkId" },
        "chunkCoordinates": { "$ref": "#/$defs/ivec2" },
        "center": { "$ref": "#/$defs/vec3" },
        "regionId": { "$ref": "#/$defs/stableId" }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "chunkId": { "type": "string", "pattern": "^chunk:-?[0-9]+:-?[0-9]+$" },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "vec2": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "ivec2": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
  }
}
